# Copy this file to .env.local and change values if needed. All are optional.

# Where API requests go. The mock API answers on /api, so leave this as-is
# unless you point the app at a real backend.
VITE_API_BASE_URL=/api

# "true" (default): MSW intercepts requests and serves the fake 5,000-product store.
# "false": requests go to VITE_API_BASE_URL for real.
VITE_ENABLE_MOCKS=true

# WebSocket that pushes live stock changes. The mock API answers this URL too.
VITE_LIVE_STOCK_URL=wss://live.bugbazaar.test/stock
